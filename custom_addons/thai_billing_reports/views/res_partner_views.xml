<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_thai_branch" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.thai.branch</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- เพิ่มช่อง Branch ใต้ Tax ID / Identifiers ฝั่งซ้าย -->
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="branch_name" string="Branch" placeholder="e.g. สำนักงานใหญ่, สาขาย่อย"/>
            </xpath>
        </field>
    </record>
</odoo>
