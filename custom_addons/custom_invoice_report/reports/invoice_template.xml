<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        One invoice = one .article, holding one full set of pages per document type
        listed in `doc_types` (keys of ENT_DOCUMENT_TITLES in models/account_move.py),
        e.g. ['invoice_original', 'invoice_copy'] prints the original then the copy.
        Each set has its own page numbering and its own totals/signature page.

        Pages are cut by account.move._ent_report_pages(): every page repeats the
        company header, title and customer boxes; only the last page of a set carries
        the totals and the two signature boxes, the others end with "continued".
    -->
    <template id="ent_invoice_document">
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="commercial" t-value="o.partner_id.commercial_partner_id"/>
        <t t-set="pages" t-value="o._ent_report_pages()"/>
        <t t-set="company_logo" t-value="o._ent_company_logo()"/>
        <div class="article ent-invoice" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
          <t t-foreach="o._ent_document_titles(doc_types)" t-as="doc">
            <t t-set="title_en" t-value="doc['title_en']"/>
            <t t-set="title_th" t-value="doc['title_th']"/>
            <t t-foreach="pages" t-as="page">
                <div t-attf-class="ent-page #{'' if page['is_last'] and doc_last else 'ent-page-break'}">

                    <!-- Company header: data of the company that owns the invoice -->
                    <t t-set="company" t-value="o.company_id"/>
                    <table class="ent-company">
                        <tr>
                            <td class="ent-logo">
                                <div class="ent-logo-box">
                                    <img t-if="company_logo" t-att-src="company_logo['src']" t-att-style="company_logo['style']" t-att-alt="company.name"/>
                                </div>
                                <div class="ent-company-tax">
                                    เลขประจำตัวผู้เสียภาษี<br/>
                                    <t t-out="o._ent_tax_id(company.vat)"/><br/>
                                    <t t-out="o._ent_branch(company.partner_id)"/>
                                </div>
                            </td>
                            <td class="ent-company-th">
                                <div class="ent-company-clip">
                                    <div t-att-class="o._ent_company_name_class(company.name, 'th')" t-out="company.name"/>
                                    <t t-foreach="o._ent_company_address_th()" t-as="addr_line">
                                        <div t-out="addr_line"/>
                                    </t>
                                    <t t-set="contact" t-value="o._ent_company_contact('โทร', 'แฟ็กซ์')"/>
                                    <div t-if="contact" t-out="contact"/>
                                </div>
                            </td>
                            <td class="ent-company-en">
                                <div class="ent-company-clip">
                                    <div t-if="company.name_en" t-att-class="o._ent_company_name_class(company.name_en, 'en')" t-out="company.name_en"/>
                                    <t t-foreach="o._ent_company_address_en()" t-as="addr_line">
                                        <div t-out="addr_line"/>
                                    </t>
                                    <t t-set="contact" t-value="o._ent_company_contact('Tel', 'Fax')"/>
                                    <div t-if="contact" t-out="contact"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Title -->
                    <div class="ent-title">
                        <div class="ent-title-en" t-out="title_en"/>
                        <div class="ent-title-th" t-out="title_th"/>
                        <div class="ent-pager">หน้า / Page <t t-out="page['number']"/>/<t t-out="page['total']"/></div>
                    </div>

                    <!-- Customer and document boxes -->
                    <div class="ent-parties">
                        <table>
                            <tr>
                                <td class="ent-box-customer">
                                    <div class="ent-box">
                                        <table>
                                            <tr>
                                                <td class="ent-label">Customer Name / ชื่อลูกค้า :</td>
                                                <td t-out="commercial.name"/>
                                            </tr>
                                            <tr>
                                                <td class="ent-label">Address / ที่อยู่ :</td>
                                                <td>
                                                    <t t-foreach="o._ent_address_lines(commercial)" t-as="addr_line">
                                                        <div t-out="addr_line"/>
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="ent-label">เลขประจำตัวผู้เสียภาษี :</td>
                                                <td>
                                                    <t t-out="o._ent_tax_id(commercial.vat)"/>
                                                    <span style="margin-left: 3mm;" t-out="o._ent_branch(commercial)"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                                <td class="ent-gap"/>
                                <td>
                                    <div class="ent-box">
                                        <table>
                                            <tr>
                                                <td class="ent-label">Invoice No. / เลขที่ :</td>
                                                <td t-out="o.name if o.name != '/' else ''"/>
                                            </tr>
                                            <tr>
                                                <td class="ent-label">Project Name :</td>
                                                <td/>
                                            </tr>
                                            <tr>
                                                <td class="ent-label">Date / วันที่ :</td>
                                                <td t-out="o._ent_long_date(o.invoice_date)"/>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Items -->
                    <table class="ent-thead">
                        <tr>
                            <th class="ent-c-no">ลำดับ<br/>NO.</th>
                            <th class="ent-c-desc">รายการ<br/>DESCRIPTION</th>
                            <th class="ent-c-qty">จำนวน<br/>QUANTITY</th>
                            <th class="ent-c-price">ราคาต่อหน่วย<br/>UNIT PRICE</th>
                            <th class="ent-c-amount">จำนวนเงิน<br/>AMOUNT</th>
                        </tr>
                    </table>
                    <div class="ent-items" t-attf-style="height: #{page['items_height']}mm;">
                        <div class="ent-vline" style="left: 7%;"/>
                        <div class="ent-vline" style="left: 51%;"/>
                        <div class="ent-vline" style="left: 61%;"/>
                        <div class="ent-vline" style="left: 80%;"/>
                        <table>
                            <t t-foreach="page['rows']" t-as="row">
                                <tr t-attf-class="ent-row-#{row['kind']}">
                                    <td class="ent-c-no" t-out="row['no']"/>
                                    <td class="ent-c-desc ent-desc" t-out="row['desc']"/>
                                    <td class="ent-c-qty" t-out="row.get('qty', '')"/>
                                    <td class="ent-c-price" t-out="row.get('price', '')"/>
                                    <td class="ent-c-amount" t-out="row.get('amount', '')"/>
                                </tr>
                            </t>
                        </table>
                    </div>

                    <!-- Last page: totals, amount in words and signatures -->
                    <t t-if="page['is_last']">
                        <!-- note | label | VAT rate | amount (= the 20% AMOUNT column above) -->
                        <table class="ent-totals">
                            <colgroup>
                                <col style="width: 48%;"/>
                                <col style="width: 26%;"/>
                                <col style="width: 6%;"/>
                                <col style="width: 20%;"/>
                            </colgroup>
                            <tr>
                                <td class="ent-note" rowspan="3">
                                    <div>Payment to be made by cheque payable to "<t t-out="company.name_en or company.name"/>"</div>
                                    <div>กรุณาสั่งจ่ายเช็คขีดคร่อมในนาม "<t t-out="company.name"/>"</div>
                                </td>
                                <td class="ent-tlabel" colspan="2">Total / รวมเป็นเงิน</td>
                                <td class="ent-tamount" t-out="o._ent_amount(o.amount_untaxed)"/>
                            </tr>
                            <tr>
                                <td class="ent-tlabel">VAT Amount / ภาษีมูลค่าเพิ่ม</td>
                                <td class="ent-rate" t-out="o._ent_vat_rate()"/>
                                <td class="ent-tamount" t-out="o._ent_amount(o.amount_tax)"/>
                            </tr>
                            <tr>
                                <td class="ent-tlabel" colspan="2">Grand Total / รวมเป็นเงินทั้งสิ้น</td>
                                <td class="ent-tamount ent-grand" t-out="o._ent_amount(o.amount_total)"/>
                            </tr>
                        </table>
                        <div class="ent-words" t-out="o._ent_baht_text()"/>
                        <table class="ent-signs">
                            <tr>
                                <td>
                                    <div class="ent-sign">
                                        <div class="ent-sign-body">
                                            <div class="ent-sign-line">..........................................................</div>
                                            <div>Invoiced by / ผู้วางบิล</div>
                                            <div>Date / วันที่ : <t t-out="o._ent_short_date(o.invoice_date)"/></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="ent-gap"/>
                                <td>
                                    <div class="ent-sign">
                                        <div class="ent-sign-body">
                                            <div class="ent-sign-line">..........................................................</div>
                                            <div>Received by / ผู้รับวางบิล</div>
                                            <div>Date / วันที่ : ......../......../............</div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </t>
                    <div t-else="" class="ent-continued">
                        มีต่อหน้าถัดไป / Continued on next page ...
                    </div>
                </div>
            </t>
          </t>
        </div>
    </template>

    <!-- One report template per Print menu entry: they only differ by doc_types. -->
    <template id="report_invoice_original">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc_types" t-value="['invoice_original']"/>
                <t t-call="custom_invoice_report.ent_invoice_document"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc_types" t-value="['invoice_copy']"/>
                <t t-call="custom_invoice_report.ent_invoice_document"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_original_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc_types" t-value="['invoice_original', 'invoice_copy']"/>
                <t t-call="custom_invoice_report.ent_invoice_document"/>
            </t>
        </t>
    </template>
</odoo>
