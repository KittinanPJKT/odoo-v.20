<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_invoice_original" model="ir.actions.report">
        <field name="name">Original Invoice (Entronica)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_invoice_report.report_invoice_original</field>
        <field name="print_report_name">'%s - %s' % ('Original Credit Note' if object.move_type == 'out_refund' else 'Original Invoice', (object._ent_doc_number() or 'Draft').replace('/', '-'))</field>
        <field name="paperformat_id" ref="paperformat_entronica_a4"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

