<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every page block is laid out in mm by the template itself (header, items,
         signatures), so wkhtmltopdf gets plain margins, no header/footer area, and
         96 dpi without smart shrinking so that 1 CSS mm is 1 printed mm. -->
    <record id="paperformat_entronica_a4" model="report.paperformat">
        <field name="name">Entronica A4 Invoice</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="css_margins" eval="False"/>
    </record>
</odoo>
