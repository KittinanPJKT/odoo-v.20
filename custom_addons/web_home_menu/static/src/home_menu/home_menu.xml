<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_home_menu.HomeMenuContainer">
        <HomeMenu t-if="this.homeMenu.isOpen()"/>
    </t>

    <t t-name="web_home_menu.HomeMenu">
        <div class="o_home_menu" t-ref="this.root">
            <div class="o_home_menu_scroll">
                <div class="o_home_menu_content">
                    <div class="o_home_menu_search" t-att-class="{ o_home_menu_search_active: this.query() }">
                        <i class="oi" data-icon="search" aria-hidden="true"/>
                        <input
                            class="o_home_menu_search_input"
                            type="text"
                            placeholder="Search apps and menus..."
                            aria-label="Search apps and menus"
                            autocomplete="off"
                            data-allow-hotkeys="true"
                            t-ref="this.input"
                            t-att-value="this.query()"
                            t-on-input="this.onInput"
                        />
                    </div>

                    <t t-set="apps" t-value="this.results().apps"/>
                    <t t-set="menuItems" t-value="this.results().menuItems"/>

                    <nav t-if="apps.length" class="o_home_menu_grid" t-ref="this.grid" aria-label="Apps">
                        <a
                            t-foreach="apps"
                            t-as="app"
                            t-key="app.id"
                            class="o_app o_home_menu_app"
                            t-att-class="{
                                o_home_menu_item_focused: this.focusedIndex() === app_index,
                                o_disabled_offline: this.isDisabledOffline(app),
                                o_home_menu_app_dragging: this.isAppDragging(app),
                                o_home_menu_app_dragover: this.isAppDragOver(app),
                            }"
                            t-att-draggable="!this.query().trim() ? 'true' : 'false'"
                            t-att-href="app.href"
                            t-att-data-menu-xmlid="app.xmlid"
                            t-on-dragstart="(ev) => this.onDragStart(ev, app)"
                            t-on-dragover="(ev) => this.onDragOver(ev, app)"
                            t-on-dragleave="(ev) => this.onDragLeave(ev, app)"
                            t-on-drop="(ev) => this.onDrop(ev, app)"
                            t-on-dragend="this.onDragEnd"
                            t-on-click.prevent="() => this.selectItem(app)"
                        >
                            <span class="o_home_menu_tile">
                                <img t-if="app.iconSrc" class="o_home_menu_icon" t-att-src="app.iconSrc" alt=""/>
                                <i
                                    t-else=""
                                    class="oi oi-2x"
                                    t-att-data-icon="app.webIcon.icon"
                                    t-attf-style="color: {{app.webIcon.color}};"
                                    aria-hidden="true"
                                />
                            </span>
                            <span class="o_home_menu_label" t-out="app.label"/>
                        </a>
                    </nav>

                    <nav t-if="menuItems.length" class="o_home_menu_results" aria-label="Menus">
                        <a
                            t-foreach="menuItems"
                            t-as="menuItem"
                            t-key="menuItem.id"
                            class="o_home_menu_result"
                            t-att-class="{
                                o_home_menu_item_focused: this.focusedIndex() === apps.length + menuItem_index,
                                o_disabled_offline: this.isDisabledOffline(menuItem),
                            }"
                            t-att-href="menuItem.href"
                            t-att-data-menu-xmlid="menuItem.xmlid"
                            t-on-click.prevent="() => this.selectItem(menuItem)"
                        >
                            <span t-if="menuItem.parents" class="o_home_menu_result_parents" t-out="menuItem.parents + ' / '"/>
                            <span t-out="menuItem.label"/>
                        </a>
                    </nav>

                    <div t-if="this.query().trim() and !apps.length and !menuItems.length" class="o_home_menu_empty">
                        No result
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
