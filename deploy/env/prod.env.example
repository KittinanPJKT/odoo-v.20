# Environment 3: PRODUCTION (ตัวจริง - สำหรับลูกค้าใช้งานจริง)
# Copy to deploy/env/prod.env and set strong passwords before starting.

ENV_NAME=prod
COMPOSE_PROJECT_NAME=odoo-prod
ODOO_CONTAINER=odoo-prod
DB_CONTAINER=db-prod
ODOO_VOLUME=odoo_data_prod

# PostgreSQL Credentials
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_PROD_DB_PASSWORD

# Odoo Database & Master Security
ODOO_DB_NAME=odoo_prod
ODOO_ADMIN_PASSWD=CHANGE_ME_PROD_MASTER_PASSWORD
ODOO_BASE_URL=https://erp.yourdomain.com

# Code & Image Isolation
# For strict branch isolation on 1 server, point to git worktree: /opt/odoo-worktrees/prod/custom_addons
CUSTOM_ADDONS_PATH=../custom_addons
ODOO_IMAGE_TAG=20.0

# Resource Limits (4C/8T shared host)
ODOO_MEM_LIMIT=6g
ODOO_CPU_LIMIT=2.5
DB_MEM_LIMIT=2g

# Backup & Cloud Off-site Sync (rclone)
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# Recommended: use an encrypted rclone crypt remote (e.g. gdrive-crypt: or r2-crypt:)
# Leave empty to keep local backups only
RCLONE_REMOTE=
RCLONE_CLOUD_RETENTION_DAYS=30
