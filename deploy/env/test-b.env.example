# Environment 2: TEST B / DEMO / UAT (ใช้ Demo ก่อนรันระบบจริง)
# Copy to deploy/env/test-b.env and set strong passwords before starting.

ENV_NAME=test-b
COMPOSE_PROJECT_NAME=odoo-test-b
ODOO_CONTAINER=odoo-test-b
DB_CONTAINER=db-test-b
ODOO_VOLUME=odoo_data_test_b

# PostgreSQL Credentials
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_TEST_B_DB_PASSWORD

# Odoo Database & Master Security
ODOO_DB_NAME=odoo_test_b
ODOO_ADMIN_PASSWD=CHANGE_ME_TEST_B_MASTER_PASSWORD
ODOO_BASE_URL=https://demo.yourdomain.com

# Code & Image Isolation
# For strict branch isolation on 1 server, point to git worktree: /opt/odoo-worktrees/test-b/custom_addons
CUSTOM_ADDONS_PATH=../custom_addons
ODOO_IMAGE_TAG=20.0

# Resource Limits (4C/8T shared host)
ODOO_MEM_LIMIT=3g
ODOO_CPU_LIMIT=1.5
DB_MEM_LIMIT=1g

# Mailpit UI (localhost only, access via SSH tunnel: ssh -L 8026:127.0.0.1:8026 user@server)
MAILPIT_LOCAL_PORT=8026

# Backup Settings (pre-demo snapshots)
BACKUP_RETENTION_DAILY=5
BACKUP_RETENTION_WEEKLY=2
BACKUP_RETENTION_MONTHLY=3
RCLONE_REMOTE=
RCLONE_CLOUD_RETENTION_DAYS=14

