# Reverse Proxy (Caddy) Domain & HTTPS Settings
# Copy to deploy/env/proxy.env before starting the proxy on the real server.

# Email for Let's Encrypt HTTPS certificate expiry notices
ACME_EMAIL=admin@yourdomain.com

# Domains pointing to your server IP (Port 80 & 443)
PROD_DOMAIN=erp.yourdomain.com
TEST_B_DOMAIN=demo.yourdomain.com
TEST_A_DOMAIN=dev.yourdomain.com

