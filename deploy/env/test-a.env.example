# Environment 1: TEST A / DEV / TEAM TESTING (สำหรับทีมทดลองและทดสอบระบบ)
# Copy to deploy/env/test-a.env and set passwords before starting.

ENV_NAME=test-a
COMPOSE_PROJECT_NAME=odoo-test-a
ODOO_CONTAINER=odoo-test-a
DB_CONTAINER=db-test-a
ODOO_VOLUME=odoo_data_test_a

# PostgreSQL Credentials
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_TEST_A_DB_PASSWORD
# Localhost-only port for pgAdmin/DBeaver via SSH tunnel (ssh -L 5434:127.0.0.1:5434 user@server)
DB_LOCAL_PORT=5434

# Odoo Database & Master Security
ODOO_DB_NAME=odoo_test_a
ODOO_ADMIN_PASSWD=CHANGE_ME_TEST_A_MASTER_PASSWORD
ODOO_BASE_URL=https://dev.yourdomain.com

# Code & Image Isolation
# For strict branch isolation on 1 server, point to git worktree: /opt/odoo-worktrees/test-a/custom_addons
CUSTOM_ADDONS_PATH=../custom_addons
ODOO_IMAGE_TAG=20.0

# Resource Limits (4C/8T shared host)
ODOO_MEM_LIMIT=2g
ODOO_CPU_LIMIT=1.0
DB_MEM_LIMIT=1g

# Mailpit UI (localhost only, access via SSH tunnel: ssh -L 8025:127.0.0.1:8025 user@server)
MAILPIT_LOCAL_PORT=8025

# Backup Settings (optional short retention)
BACKUP_RETENTION_DAILY=3
BACKUP_RETENTION_WEEKLY=0
BACKUP_RETENTION_MONTHLY=0
RCLONE_REMOTE=
RCLONE_CLOUD_RETENTION_DAYS=7

